FROM ghcr.io/berriai/litellm@sha256:c560d317136880ea92d62334d4367ab10955b1af189dd3ea24f6551290b1d6c1

ARG LITELLM_RELEASE_TAG=v1.106.4
ENV LITELLM_RELEASE_TAG=${LITELLM_RELEASE_TAG}

# The fork has no Rust source changes; retain the official amd64 maturin
# extension and overlay the complete fork Python package instead of rebuilding
# it under arm64/QEMU.
COPY litellm/ /tmp/fork-litellm/
RUN find /tmp/fork-litellm -type f \( -name '*.so' -o -name '*.pyd' \) -delete && \
    cp -a /tmp/fork-litellm/. /app/.venv/lib/python3.13/site-packages/litellm/ && \
    rm -rf /tmp/fork-litellm

